# Form Submission Configuration (FormSubmit.co)
# General business & practice inquiries default to:
VITE_FORMSUBMIT_EMAIL=admin@envertgroup.com

# Job applications & recruitment inquiries default to:
VITE_FORMSUBMIT_HR_EMAIL=hr@envertgroup.com

# Optional custom override endpoint (e.g. Formspree or custom webhook):
# VITE_FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/admin@envertgroup.com
